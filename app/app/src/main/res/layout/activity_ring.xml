<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/ringLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.34"
        android:text="WECKER"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ringClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-thin"
        android:includeFontPadding="false"
        android:text="--:--"
        android:textColor="@color/text"
        android:textSize="92sp" />

    <TextView
        android:id="@+id/ringDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_dim"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/ringSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_off"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_outline"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.16"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:text="SCHLUMMERN"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/btn_primary"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:paddingTop="22dp"
        android:paddingBottom="22dp"
        android:text="STOPP"
        android:textColor="#FF14181F"
        android:textSize="15sp" />
</LinearLayout>
