<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/rowBar"
        android:layout_width="3dp"
        android:layout_height="64dp"
        android:background="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/rowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:text="07:00"
            android:textColor="@color/text"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/rowMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.06"
            android:text="Mo-Fr"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:fontFamily="monospace"
        android:text="#1"
        android:textColor="@color/text_off"
        android:textSize="11sp" />

    <Switch
        android:id="@+id/rowSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:thumbTint="@color/accent"
        android:trackTint="@color/accent_dim"
        tools:ignore="UseSwitchCompatOrMaterialXml" />
</LinearLayout>
