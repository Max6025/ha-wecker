#define WLAN_PASS "geheim"

// Home Assistant, fuer die Selbstanmeldung (siehe haAnmelden im Sketch).
// Die lokale Adresse, nicht die oeffentliche: der Arduino spricht hier nur
// HTTP. Der Token ist ein langlebiger aus dem Benutzerprofil und braucht
// Verwalterrechte, sonst nimmt Home Assistant den Einrichtungsablauf nicht an.
#define HA_HOST  "192.168.1.100"
#define HA_PORT  8123
#define HA_TOKEN "eyJ..."
